# Copy to .env and fill in. ADMIN_KEY, API_KEY and DATA_ENCRYPTION_KEY are required.
HOST=127.0.0.1
PORT=8080
# Set to 1 only behind a reverse proxy (e.g. Caddy) that overwrites X-Forwarded-Proto,
# so that response_format=url returns https links.
TRUST_PROXY=0
ADMIN_KEY=replace-with-admin-key
API_KEY=replace-with-client-api-key
# 32 bytes as 64 hex characters: openssl rand -hex 32. Back it up; losing it makes stored tokens unreadable.
DATA_ENCRYPTION_KEY=replace-with-64-hex-characters
DATA_DIR=./data
CHATGPT_BASE_URL=https://chatgpt.com/backend-api

# Optional: Tencent Cloud super-resolution (/SR/) and enhancement (/CR/) post-processing.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_REGION=ap-guangzhou
TENCENT_TIIA_BASE_URL=https://tiia.tencentcloudapi.com
TENCENT_COS_BASE_URL=
